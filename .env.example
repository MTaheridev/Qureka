# Relative SQLite paths are resolved against prisma/schema.prisma.
# The packaged app ignores this and stores the database in the OS user-data directory.
DATABASE_URL="file:./easy-reporter.db"

# Optional: AvalAI OpenAI-compatible provider (https://docs.avalai.ir/fa/quickstart)
# Prefer entering the key in the app UI (AI models) so Electron can encrypt it.
AVALAI_API_KEY=
AVALAI_MODEL="claude-haiku-5-5"
AVALAI_BASE_URL="https://api.avalai.ir/v1"
